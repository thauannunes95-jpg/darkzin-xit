-- Injeção Segura
local function SafeParent(gui)
    local targets = {game:GetService("CoreGui"), LocalPlayer:WaitForChild("PlayerGui")}
    for _, target in pairs(targets) do
        pcall(function() gui.Parent = target end)
    end
end

-- Lógica de Identificação de Funções
local function GetPlayerRole(player)
    if not player or not player.Character then return "Innocent" end
    local char = player.Character
    local backpack = player:FindFirstChild("Backpack")
    if char:FindFirstChild("Knife") or (backpack and backpack:FindFirstChild("Knife")) then
        return "Murder"
    elseif char:FindFirstChild("Gun") or (backpack and backpack:FindFirstChild("Gun")) then
        return "Sheriff"
    end
    return "Innocent"
end

-- Sistema de ESP Segmentado
local function CreateESP(player)
    local highlight = Instance.new("Highlight")
    highlight.Name = "DZ_ESP_Highlight"
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.Parent = player.Character or player.CharacterAdded:Wait()

    RunService.RenderStepped:Connect(function()
        local role = GetPlayerRole(player)
        local enabled = false
        local color = Color3.new(1,1,1)

        if role == "Murder" and getgenv().DZ_ESP_Murder then
            enabled = true
            color = Theme.Murder
        elseif role == "Sheriff" and getgenv().DZ_ESP_Sheriff then
            enabled = true
            color = Theme.Sheriff
        elseif role == "Innocent" and getgenv().DZ_ESP_Inno then
            enabled = true
            color = Theme.Innocent
        end

        highlight.Enabled = enabled
        highlight.FillColor = color
        highlight.OutlineColor = Color3.new(1,1,1)
    end)
end

-- ESP para a Arma
local function GunESP()
    task.spawn(function()
        while task.wait(1) do
            if getgenv().DZ_ESP_Gun then
                for _, v in pairs(workspace:GetDescendants()) do
                    if v.Name == "Gun" and v:IsA("BasePart") and not v:FindFirstChild("DZ_Highlight") then
                        local h = Instance.new("Highlight")
                        h.Name = "DZ_Highlight"
                        h.FillColor = Theme.Gun
                        h.Parent = v
                    end
                end
            else
                for _, v in pairs(workspace:GetDescendants()) do
                    if v.Name == "DZ_Highlight" then v:Destroy() end
                end
            end
        end
    end)
end

-- Silent Aim Logic
local function GetClosestPlayer()
    local closest = nil
    local dist = math.huge
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
            local pos, onScreen = Camera:WorldToViewportPoint(player.Character.Head.Position)
            if onScreen then
                local magnitude = (Vector2.new(pos.X, pos.Y) - UserInputService:GetMouseLocation()).Magnitude
                if magnitude < dist then
                    closest = player
                    dist = magnitude
                end
            end
        end
    end
    return closest
end

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
        if method == "FireServer" and (getgenv().DZ_SilentAim_Sheriff or getgenv().DZ_SilentAim_Murder) then
            local isSheriffEvent = self.Name:find("Shoot") or self.Name:find("Fire")
            local isMurderEvent = self.Name:find("Knife") or self.Name:find("Attack")
            
            if (isSheriffEvent and getgenv().DZ_SilentAim_Sheriff) or (isMurderEvent and getgenv().DZ_SilentAim_Murder) then
                local target = GetClosestPlayer()
                if target and target.Character then
                    args[1] = target.Character.Head.Position
                end
                return oldNamecall(self, unpack(args))
            end
    return oldNamecall(self, ...)
end)

-- Auto Get Gun
local function AutoGunLogic()
    task.spawn(function()
        while task.wait(0.1) do
            if getgenv().DZ_AutoGun then
                pcall(function()
                    for _, v in pairs(workspace:GetDescendants()) do
                        if v.Name == "Gun" and v:IsA("BasePart") then
                            LocalPlayer.Character.HumanoidRootPart.CFrame = v.CFrame
                        end
                    end
                end)
            end
        end
    end)
end

